rules_version = '2';
// Media: children/media, mealOptions, events, announcements
// Teacher write: allow via custom claims OR Firestore user doc (fallback if claims not yet synced).

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Helper: teacher at this school (from token claims or Firestore)
    function isTeacherAtSchool(schoolId) {
      return request.auth != null && (
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'teacher')
        || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'teacher'
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.schoolId == schoolId)
      );
    }
    function callerUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    // Legacy: parentStatus omitted => full access (matches Firestore rules).
    function parentStatusAllowsParentAccess() {
      return !('parentStatus' in callerUserData()) || callerUserData().parentStatus == 'ACTIVE';
    }
    function isActiveParent() {
      return request.auth != null
        && request.auth.token.role == 'parent'
        && parentStatusAllowsParentAccess();
    }
    match /schools/{schoolId}/children/{childId}/photos/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.token.schoolId == schoolId
            || request.auth.token.role == 'super_admin'
            || (isActiveParent() && firestore.get(/databases/(default)/documents/schools/$(schoolId)/children/$(childId)).data.parentIds.hasAny([request.auth.uid])));
      allow write: if isTeacherAtSchool(schoolId);
    }
    match /schools/{schoolId}/children/{childId}/media/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.token.schoolId == schoolId
            || request.auth.token.role == 'super_admin'
            || (isActiveParent() && firestore.get(/databases/(default)/documents/schools/$(schoolId)/children/$(childId)).data.parentIds.hasAny([request.auth.uid])));
      allow write: if isTeacherAtSchool(schoolId);
    }
    match /schools/{schoolId}/mealOptions/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.token.schoolId == schoolId || request.auth.token.role == 'super_admin');
      allow write: if request.auth != null && request.auth.token.schoolId == schoolId && (request.auth.token.role == 'principal' || request.auth.token.role == 'super_admin');
    }
    match /schools/{schoolId}/events/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.token.schoolId == schoolId || request.auth.token.role == 'super_admin');
      allow write: if request.auth != null && request.auth.token.schoolId == schoolId && (request.auth.token.role == 'principal' || request.auth.token.role == 'teacher' || request.auth.token.role == 'super_admin');
    }
    match /schools/{schoolId}/announcements/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.token.schoolId == schoolId || request.auth.token.role == 'super_admin');
      allow write: if request.auth != null && request.auth.token.schoolId == schoolId && (request.auth.token.role == 'principal' || request.auth.token.role == 'teacher' || request.auth.token.role == 'super_admin');
    }
  }
}
