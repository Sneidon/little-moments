{
  "name": "my-little-moments-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "setup-env": "node scripts/copy-env.js",
    "build:splash-icon": "node scripts/build-splash-icon.cjs",
    "postinstall": "patch-package",
    "build:apk": "npm run setup-env && eas build --platform android --profile production",
    "build:ios": "npm run setup-env && eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "12.17.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-image-crop-picker": "^0.52.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "@firebase/app": "0.16.0"
  }
}
