{
  "name": "my-little-moments-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "setup-env": "node scripts/copy-env.js",
    "build:splash-icon": "node scripts/build-splash-icon.cjs",
    "postinstall": "patch-package",
    "build:apk": "npm run setup-env && eas build --platform android --profile production",
    "build:ios": "npm run setup-env && eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/datetimepicker": "^7.7.0",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "expo": "~50.0.0",
    "expo-build-properties": "~0.11.1",
    "expo-file-system": "~16.0.9",
    "expo-font": "~11.10.3",
    "expo-image-picker": "~14.7.1",
    "expo-notifications": "~0.27.0",
    "expo-splash-screen": "~0.26.5",
    "expo-status-bar": "~1.11.0",
    "expo-system-ui": "~2.9.4",
    "firebase": "^10.7.0",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-image-crop-picker": "^0.41.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "patch-package": "^8.0.1",
    "typescript": "^5.1.3"
  },
  "private": true
}
