+/// Carries a call-scoped raw pointer into a synchronous `assumeIsolated` closure. Swift 6.2
+/// (Xcode 26.2/26.3) does not honour `nonisolated(unsafe)` on such captures and reports
+/// "sending ... risks causing data races"; the pointer never outlives the call, so this is sound.
+private struct UnsafeSendableBox<Value>: @unchecked Sendable {
+  let value: Value
+  init(_ value: Value) { self.value = value }
+}
