{
  "expo": {
    "name": "My Little Moments",
    "slug": "little-moments",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "backgroundColor": "#000000",
        "image": "./assets/splash-icon.png"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.0",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      "@react-native-firebase/app/app.plugin.js",
      "./plugins/withRnFirebaseStaticFramework",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#7B61FF",
          "mode": "production",
          "iosDisplayInForeground": true
        }
      ],
      "@react-native-firebase/messaging/app.plugin.js",
      "./plugins/withFirebaseNotificationManifestFix",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Little Moments to access your photos and videos to attach to updates.",
          "cameraPermission": "Allow Little Moments to use the camera to take photos and record videos for updates.",
          "microphonePermission": "Allow Little Moments to use the microphone when recording videos for updates."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "co.za.mylittlemoments",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png"
        }
      },
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserNotificationsUsageDescription": "My Little Moments sends alerts for daily updates, messages, and school announcements.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7B61FF"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png"
        }
      },
      "package": "co.za.mylittlemoments",
      "googleServicesFile": "./firebase/google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "d0c62874-2bcb-4046-b9c1-6a5fb470db7d"
      }
    },
    "owner": "mukondleteri"
  }
}
